# WMS Simple Enterprise — template environment produksi (server innaka)
# Salin ke .env lalu isi nilai aslinya. File .env TIDAK di-commit (git-ignored).

# Port HTTP gateway yang expose ke internet (nginx)
WMS_HTTP_PORT=8090

# PostgreSQL global stack host (container global_postgres, port 5432 di host)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=wms_app
DB_PASSWORD=
DB_NAME=wms_simple_db

# Secret JWT backend — generate: openssl rand -hex 32
JWT_SECRET=
